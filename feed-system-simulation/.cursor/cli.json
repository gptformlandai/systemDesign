{
  "permissions": {
    "allow": [
      "Shell(docker compose *)",
      "Shell(mvn *)",
      "Shell(git status)",
      "Shell(git diff *)",
      "Shell(git log *)"
    ],
    "deny": [
      "Shell(git push --force *)",
      "Shell(rm -rf *)"
    ]
  },
  "sandbox": {
    "mode": "enabled",
    "networkAccess": "user_config_with_defaults"
  }
}
